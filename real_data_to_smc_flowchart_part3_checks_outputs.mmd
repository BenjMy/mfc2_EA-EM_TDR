    PE --> PE1["signed error theta_calc - theta_TDR<br/>per station, epoch, horizon"]
    PE --> PE2["RMSE and bias<br/>per station and per epoch"]

    classDef todo fill:#eeeeee,stroke:#888,stroke-dasharray: 4 3,color:#333;
