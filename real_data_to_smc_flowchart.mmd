flowchart TD
    %% ---------- inputs ----------
    subgraph IN["Inputs (real data)"]
        EM["EM survey CSVs<br/>(EMI, time-lapse)"]
        TDR["TDR / SWC probes<br/>(theta, per depth)"]
        XY["Sensor coordinates"]
    end

    EM & TDR & XY --> S0["Step 0 / 0b<br/>load, filter, match EM points to probes<br/>coverage check of horizons"]

    S0 --> O_SUB{{"EM thinning<br/>em_subsample: off | grid | probes | stride | random"}}
    O_SUB --> O_SPLIT{{"--train-val-split<br/>off | by_probe | by_time_block |<br/>alternate_sorted | random"}}
    O_SPLIT --> O_STAGE{"--stage"}

    %% ---------- stage options ----------
    O_STAGE -- "full (default)" --> S1
    O_STAGE -- "calibrate" --> S1c["Step 1: invert ALL members<br/>on probe neighbourhoods only"]
    O_STAGE -- "map" --> S1m["Step 1: invert ONLY the K members<br/>stored in stage_calibration.json<br/>on all EM points"]

    %% ---------- ensemble ----------
    S1["Step 1: ensemble of EM inversions<br/>alpha x forward model (FSlin, CS) x start conductivities x epochs"]
    S1c --> S2
    S1m --> S2
    S1 --> S2

    S2["Step 2: Waxman-Smits per member<br/>(a, m, sigma_w, sigma_s per horizon)<br/>ws_fixed_params, lab_p0, bounds"]
    S2 --> S3["Step 3: rank members by probe RMSE<br/>build cumulative stacks K = 1..N"]
    S3 --> S4["Step 4: recalibrate WS on each stack<br/>(global fit, one set per horizon)"]

    %% ---------- K selection ----------
    S4 --> O_K{"--k-selection"}
    O_K -- "global (default)" --> K1["K = argmin probe RMSE<br/>of the global fit"]
    O_K -- "localized-loo" --> K2["K = argmin leave-one-probe-out RMSE<br/>of the localized fit<br/>(needs bandwidth)"]
    K1 --> K["Optimal stack K<br/>+ CV uncertainty map"]
    K2 --> K

    %% ---------- calibration unit of the maps (--ws-spatial) ----------
    K --> O_MAP{"--ws-spatial<br/>(supersedes --ws-map-calibration)"}
    O_MAP -- "global" --> M2["One WS set per horizon<br/>(pooled over all stations)"]
    O_MAP -- "localized (default)" --> M1["Gaspari-Cohn localized WS<br/>per EM point; pooled fit if no probe within 2c"]
    O_MAP -. "comparison only (not a choice)" .-> B1

    BW["Bandwidth c:<br/>--ws-localized-bandwidth | sweep (LOO-CV) |<br/>calibration run | scenario value"] -.-> M1
    SWA["A: sweep from probe spacing<br/>c = 0.5-5 x median nearest-neighbour distance<br/>flag if all c below the spacing"] -.-> BW

    subgraph ST["Per-station WS: comparison only (ws_spatial.py)"]
        B1["B: per-station sigma_s fit, per horizon<br/>a, m, sigma_w held at pooled value (prior centre)<br/>shrinkage towards the pooled fit; fewer than 3 obs: pooled"]
        B1 --> B2["ws_by_station.csv<br/>station, x, y, horizon, sigma_s, n_obs, RMSE, at-bound"]
        B1 --> C1{"C: spread station values<br/>over the EM points"}
        C1 -- "voronoi: nearest station" --> D1
        C1 -- "idw: 1/d^p, power p" --> D1
        D1["D: per-point parameters (4, layers, points)<br/>pooled value where no station is fitted"]
    end

    M1 --> SMC
    M2 --> SMC
    D1 --> E1["E: ws_spatial_sigma_s_map.png<br/>field + stations + pooled line"]

    %% ---------- method choice (implemented in ws_spatial.py, not yet called by the pipeline) ----------
    LOSO["Leave-one-station-out CV of theta<br/>global | voronoi | idw | localized<br/>simplest within 1 SE of the best"] -.-> O_MAP

    %% ---------- checks ----------
    SMC --> V5b["Step 5b: held-out validation RMSE<br/>(global + localized / station mapping)"]
    SMC --> V5c["Step 5c (opt-in): EM footprint check<br/>--em-footprint-diagnostic"]
    SMC --> V6["Step 6: plots, SWC uncertainty"]
    SMC -.-> PE["F: probe error map + probe_errors.csv<br/>in-sample and held-out (functions ready, not wired)"]
    O_STAGE -. "calibrate output:<br/>stage_calibration.json" .-> S1m

    classDef opt fill:#fff4d6,stroke:#c79100,color:#333;
    classDef todo fill:#eeeeee,stroke:#888,stroke-dasharray: 4 3,color:#333;
    classDef out fill:#d9f2e3,stroke:#2e8b57,color:#133;
    class O_SUB,O_SPLIT,O_STAGE,O_K,O_MAP opt;
    class SMC,B2,E1 out;
    class SWA,LOSO,PE todo;
